+class QrAuthorizationTests(unittest.TestCase):
+    """Exercise the existing HTTP contract and isolated persisted recovery."""
+
+    def setUp(self):
+        from backend import auth, account_pool, rss_scheduler
+        self.auth = auth
+        self.pool_module = account_pool
+        directory = tempfile.TemporaryDirectory(prefix="qr-authorization-test-")
+        self.addCleanup(directory.cleanup)
+        self.root = Path(directory.name)
+        self.pool_file = self.root / "pool.json"
+        self.subs_file = self.root / "subscriptions.json"
+        self.pool_file.write_text("[]", encoding="utf-8")
+        self.subs_file.write_text("[]", encoding="utf-8")
+        self.scheduler = rss_scheduler.RssScheduler()
+        self.addCleanup(self.scheduler._executor.shutdown, wait=False)
+        self.workers = []
+        self.now = [1000.0]
+        self.network = Mock()
+        self.network.get.return_value.json.return_value = {"wx_errcode": 405, "wx_code": "confirmed"}
+        self.credentials = {"vid": "123", "accessToken": "PRIVATE-TOKEN", "refreshToken": "PRIVATE-REFRESH"}
+        for module, name, value in (
+            (auth, "_login_session", None),
+            (auth, "_login_state", dict(status="idle", message="", progress=0, qrcode="", uuid="", expires_at=0)),
+            (account_pool, "ACCOUNT_POOL_FILE", self.pool_file),
+            (rss_scheduler, "RSS_SUBSCRIPTIONS_FILE", self.subs_file),
+            (rss_scheduler, "rss_scheduler", self.scheduler),
+        ):
+            self.patch(module, name, value)
+        self.patch(auth.time, "time", side_effect=lambda: self.now[0])
+        self.qr = self.patch(auth, "get_qr_data", side_effect=[
+            {"uuid": name, "qrcode": {"qrcodebase64": "aW1hZ2U="}} for name in ("qr-one", "qr-two", "qr-three")
+        ])
+        self.patch(auth, "get_weread_session", return_value=self.network)
+        self.exchange = self.patch(auth, "exchange_weread_token", return_value=self.credentials)
+        # Capture the daemon entry point; individual tests release blocked calls explicitly.
+        self.patch(auth.threading, "Thread", side_effect=self.capture_worker)
+        self.patch(self.scheduler, "is_in_fetch_window", return_value=True)
+        import backend.weread_signer as signer
+        self.patch(signer, "activate_terminal_session")
+        self.patch(__import__("requests").sessions.Session, "request",
+                   side_effect=AssertionError("Unexpected network call"))
+        self.app = Flask(__name__)
+        self.app.register_blueprint(auth.auth_bp)
+        self.client = self.app.test_client()
+
+    def patch(self, module, name, value=..., **kwargs):
+        patcher = patch.object(module, name, value, **kwargs) if value is not ... else patch.object(module, name, **kwargs)
+        result = patcher.start()
+        self.addCleanup(patcher.stop)
+        return result
+
+    def capture_worker(self, target, args, daemon):
+        self.workers.append(lambda: target(*args))
+        return Mock()
+
+    def qr_request(self, method="post"):
+        response = getattr(self.client, method)("/api/auth/qrcode")
+        self.assertEqual(response.status_code, 200)
+        return response.get_json()
+
+    def state(self):
+        return self.client.get("/api/auth/status").get_json()["login_state"]
+
+    def test_live_qr_reused_across_routes_and_scanned_state(self):
+        first = self.qr_request()
+        self.assertEqual(first["expires_at"], 1300)
+        self.assertEqual(first["expires_at"], first["login_state"]["expires_at"])
+        for route in ("/api/auth/qrcode", "/api/auth/login", "/api/auth/login-browser"):
+            response = self.client.post(route).get_json()
+            for field in ("uuid", "qrcode", "qrcode_url", "expires_at"):
+                self.assertEqual(first[field], response[field])
+        def scanned(*args, **kwargs):
+            self.network.get.return_value.json.return_value = {"wx_errcode": 404}
+            if self.network.get.call_count > 1:
+                self.assertEqual(self.qr_request()["uuid"], first["uuid"])
+                self.assertEqual(self.state()["status"], "scanned")
+                self.client.post("/api/auth/cancel")
+            return self.network.get.return_value
+        self.network.get.side_effect = scanned
+        self.workers[0]()
+        self.assertEqual(self.qr.call_count, 1)
+
+    def test_concurrent_qr_requests_share_one_session(self):
+        # Use real thread objects captured before patching threading.Thread.
+        from concurrent.futures import ThreadPoolExecutor
+        with ThreadPoolExecutor(max_workers=4) as executor:
+            # ThreadPoolExecutor itself needs the real thread constructor.
+            with patch.object(self.auth.threading, "Thread", REAL_THREAD):
+                # Stub only the auth worker launch, not the concurrent clients.
+                with patch.object(self.auth, "_background_poll_login", return_value=None):
+                    results = list(executor.map(
+                        lambda _: self.app.test_client().post("/api/auth/qrcode").get_json(), range(8)))
+        self.assertEqual({item["uuid"] for item in results}, {"qr-one"})
+        self.assertEqual(len({item["expires_at"] for item in results}), 1)
+        self.assertEqual(self.qr.call_count, 1)
+
+    def test_cancelled_or_expired_blocked_worker_cannot_commit_or_replace_new_session(self):
+        for boundary in ("poll", "exchange"):
+            for action in ("cancel", "expire"):
+                with self.subTest(boundary=boundary, action=action):
+                    self.setUp_session_for_race(boundary, action)
+
+    def setUp_session_for_race(self, boundary, action):
+        # Reset only the local fixture; no account/session file from the repository.
+        self.client.post("/api/auth/cancel")
+        self.qr.side_effect = None
+        self.qr.return_value = {"uuid": f"old-{boundary}-{action}", "qrcode": {"qrcodebase64": "aW1hZ2U="}}
+        self.qr_request()
+        worker = self.workers[-1]
+        entered, release = threading.Event(), threading.Event()
+        response = Mock()
+        response.json.return_value = {"wx_errcode": 405, "wx_code": "confirmed"}
+        def blocked(*args, **kwargs):
+            entered.set()
+            if not release.wait(5):
+                raise AssertionError("Blocked fixture was not released")
+            return response if boundary == "poll" else self.credentials
+        self.network.get.side_effect = blocked if boundary == "poll" else None
+        self.exchange.side_effect = blocked if boundary == "exchange" else None
+        thread = REAL_THREAD(target=worker)
+        thread.start()
+        try:
+            self.assertTrue(entered.wait(5))
+            if action == "cancel":
+                self.client.post("/api/auth/cancel")
+            else:
+                self.now[0] += 301
+            self.qr.return_value = {"uuid": f"new-{boundary}-{action}", "qrcode": {"qrcodebase64": "bmV3"}}
+            newer = self.qr_request()
+        finally:
+            release.set()
+            thread.join(5)
+        self.assertFalse(thread.is_alive())
+        self.assertEqual(self.state(), newer["login_state"])
+        self.assertEqual(json.loads(self.pool_file.read_text(encoding="utf-8")), [])
+
+    def test_phone_confirmation_updates_same_account_and_only_resumes_idle_auth_failures(self):
+        self.pool_module.account_pool.add_or_update(dict(self.credentials, accessToken="OLD"))
+        rows = [
+            dict(fakeid=name, enabled=enabled, interval_minutes=60, next_fetch_time=9999,
+                 last_fetch_time=800, last_error=error)
+            for name, enabled, error in (
+                ("auth", True, "登录已过期"), ("disabled", False, "401"),
+                ("inflight", True, "401"), ("captcha", True, "captcha login"),
+                ("collection", True, "timeout"), ("healthy", True, None))
+        ]
+        self.subs_file.write_text(json.dumps(rows), encoding="utf-8")
+        self.scheduler._fetching.add("inflight")
+        self.qr_request()
+        self.workers[-1]()
+        self.assertEqual(self.state()["status"], "success")
+        self.assertEqual(self.state()["progress"], 100)
+        accounts = json.loads(self.pool_file.read_text(encoding="utf-8"))
+        self.assertEqual(len(accounts), 1)
+        self.assertEqual(accounts[0]["accessToken"], "PRIVATE-TOKEN")
+        saved = json.loads(self.subs_file.read_text(encoding="utf-8"))
+        self.assertEqual(saved[0], dict(rows[0], next_fetch_time=1000))
+        self.assertEqual(saved[1:], rows[1:])
+        with patch.object(self.scheduler, "submit_fetch") as submit:
+            self.scheduler.is_in_fetch_window.return_value = False
+            self.scheduler._tick()
+            submit.assert_not_called()
+            self.scheduler.is_in_fetch_window.return_value = True
+            self.scheduler._tick()
+            self.assertEqual([call.args[0]["fakeid"] for call in submit.call_args_list], ["auth"])
+        self.assertEqual(self.scheduler.health_snapshot()["subscriptions"][0]["error_kind"], "auth")
+
+    def test_failed_exchange_and_qr_generation_never_disclose_raw_secrets(self):
+        self.qr_request()
+        self.exchange.return_value = {"error": "PRIVATE-LOGIN-RESPONSE"}
+        with self.assertLogs(self.auth.logger, level="WARNING") as logs:
+            self.workers[-1]()
+        self.assertEqual(self.state()["status"], "failed")
+        self.assertNotIn("PRIVATE", json.dumps(self.state()) + "\n".join(logs.output))
+        self.qr.side_effect = RuntimeError("PRIVATE-NETWORK-ERROR")
+        response = self.client.post("/api/auth/qrcode")
+        self.assertEqual(response.status_code, 500)
