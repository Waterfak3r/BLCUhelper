+        )):
+            return "auth"
+        return "collection"
+
+    def resume_auth_failed_subscriptions(self):
+        """Make only enabled, idle auth failures due; a fetch clears the error."""
+        with self._lock, self._fetching_lock:
+            subs = self.get_subscriptions()
+            now = time.time()
+            changed = False
+            for sub in subs:
+                if (sub.get("enabled") and sub.get("fakeid") not in self._fetching
+                        and self._error_kind(sub.get("last_error")) == "auth"):
+                    sub["next_fetch_time"] = now
