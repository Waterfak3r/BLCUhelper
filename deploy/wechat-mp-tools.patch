+
+        subscriptions = []
+        for sub in raw_subs:
+            if not isinstance(sub, dict) or self._is_legacy_fakeid(sub.get("fakeid")):
+                continue
+            error_kind = self._error_kind(sub.get("last_error"))
+            last_fetch = self._safe_float(sub.get("last_fetch_time"), 0)
+            next_fetch = self._safe_float(sub.get("next_fetch_time"), 0)
+            subscriptions.append({
