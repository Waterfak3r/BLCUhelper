# Copy to /etc/blcuhelper/wechat-mp-watchdog.env; owner root:root, mode 0600 (read by systemd).
# Independent host monitor: never load the website .env into this service.
# Fill these values before enabling. No mail or full checks until exactly true.
WATCHDOG_EMAIL_ENABLED=false
WATCHDOG_SMTP_HOST=
# TLS defaults to 465; starttls defaults to 587 when port is blank.
WATCHDOG_SMTP_PORT=
WATCHDOG_SMTP_SECURITY=tls
# Optional for a trusted TLS relay; username and password must be supplied together.
WATCHDOG_SMTP_USERNAME=
WATCHDOG_SMTP_PASSWORD=
WATCHDOG_MAIL_FROM=
# Exactly one recipient address; recipient lists are rejected before any recovery.
WATCHDOG_MAIL_TO=
# Optional enterprise CA bundle, verified by Python ssl.create_default_context:
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Note: When genuine WeChat authorization is needed, the watchdog sends an authorization QR
# inline image and attachment to WATCHDOG_MAIL_TO. The user confirms on their phone;
# no passwords, cookies, or tokens are transmitted.
# If a QR expires (5-minute TTL), manual renewal can be initiated with --authorize:
# sudo systemd-run --wait --pipe --property=EnvironmentFile=/etc/blcuhelper/wechat-mp-watchdog.env \
#   /usr/bin/python3 /opt/blcuhelper/scripts/wechat-mp-watchdog.py --authorize --state /var/lib/blcu-wechat-mp-watchdog/state.json
